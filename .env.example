# ── Database — Amazon Aurora PostgreSQL via RDS Proxy ────────────────────────
# Format: postgres://USER:PASSWORD@YOUR-RDS-PROXY-ENDPOINT:5432/memorymatch
# Production credential lives in AWS Secrets Manager; paste the rotated value
# here for local dev only. SSL is required by default (set DATABASE_SSL=disable
# only for a local docker postgres).
DATABASE_URL=postgres://user:password@localhost:5432/memorymatch
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=3

# ── Auth — Clerk (https://dashboard.clerk.com) ───────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Signing secret for the user-sync webhook (Clerk dashboard → Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── Rate limiting — Upstash Redis (optional in dev; no-op when unset) ────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Media uploads — Vercel Blob (P1) ─────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Observability — Sentry (P0 per PRD §34) ──────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Location — Google Maps Places API (server-side only) ─────────────────────
# Enable Places API + billing in Google Cloud Console. Used for city autocomplete
# and geocoding during onboarding; key is never exposed to the browser.
GOOGLE_MAPS_API_KEY=
